{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/impresion-3d",
      "destination": "/maquetas-3d",
      "permanent": true
    },
    {
      "source": "/impresion-3d.html",
      "destination": "/maquetas-3d",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/proyectos",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/proyectos",
      "permanent": true
    },
    {
      "source": "/producto/:slug",
      "destination": "/productos/:slug",
      "permanent": true
    },
    {
      "source": "/productos",
      "destination": "/maquetas-urbanas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/producto",
      "destination": "/producto.html"
    },
    {
      "source": "/manuales/manual-sketchup.pdf",
      "destination": "/manuales/manual_sketchup_arquitectura.pdf"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
