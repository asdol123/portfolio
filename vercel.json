{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/manuales/manual-sketchup.pdf",
      "destination": "/manuales/manual_sketchup_arquitectura.pdf"
    },
    {
      "source": "/manuales/manual-sketchup.html",
      "destination": "/manuales/manual_sketchup_arquitectura.html"
    },
    {
      "source": "/_taller-privado/agenda-pedidos",
      "destination": "/taller-privado/agenda-pedidos.html"
    },
    {
      "source": "/_taller-privado/agenda-pedidos.html",
      "destination": "/taller-privado/agenda-pedidos.html"
    },
    {
      "source": "/taller-privado/agenda-pedidos",
      "destination": "/taller-privado/agenda-pedidos.html"
    },
    {
      "source": "/agenda-pedidos",
      "destination": "/taller-privado/agenda-pedidos.html"
    },
    {
      "source": "/taller/pedidos",
      "destination": "/taller-privado/agenda-pedidos.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
